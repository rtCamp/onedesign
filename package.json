{
	"name": "onedesign",
	"private": true,
	"engines": {
		"node": ">=24.15.0",
		"npm": ">=11.19.0"
	},
	"files": [
		"assets",
		"build",
		"inc",
		"languages",
		"vendor",
		"readme.txt",
		"onedesign.php",
		"uninstall.php"
	],
	"scripts": {
		"build:dev": "cross-env NODE_ENV=development npm run build:js",
		"build:js": "wp-scripts build --experimental-modules --blocks-manifest --webpack-copy-php",
		"build:prod": "npm run clean && cross-env NODE_ENV=production npm run build:js",
		"clean": "rimraf build",
		"format": "wp-scripts format",
		"i18n:make-pot": "wp-env run cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/ -- wp i18n make-pot . ./languages/onedesign.pot --domain=onedesign --include='*.php,inc,src' --exclude='assets,build,node_modules,tests,vendor'",
		"i18n:make-json": "wp-env run cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/ -- wp i18n make-json languages/ --no-purge",
		"lint:css:fix": "wp-scripts lint-style --fix",
		"lint:css": "wp-scripts lint-style",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"lint:js:types": "tsc --noEmit",
		"lint:js": "wp-scripts lint-js",
		"lint:php:fix": "wp-env run cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/ composer run-script format",
		"lint:php:stan": "wp-env run cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/ composer run-script phpstan",
		"lint:php": "wp-env run cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/ composer run-script lint",
		"plugin-zip": "wp-scripts plugin-zip",
		"prepare": "lefthook install",
		"start:js": "wp-scripts start --experimental-modules --blocks-manifest",
		"test:e2e": "wp-scripts test-playwright",
		"test:js": "wp-scripts test-unit-js",
		"test:js:watch": "wp-scripts test-unit-js --watch",
		"test:js:coverage": "wp-scripts test-unit-js --coverage",
		"test:php": "npm run wp-env:test -- run cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/ vendor/bin/phpunit -c phpunit.xml.dist",
		"wp-env": "wp-env",
		"wp-env:cli": "wp-env run cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/",
		"wp-env:child": "wp-env --config=.wp-env.child.json",
		"wp-env:test": "wp-env --config=.wp-env.test.json"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.40.0",
		"@wordpress/block-editor": "^15.11.0",
		"@wordpress/blocks": "^15.13.0",
		"@wordpress/components": "^30.9.0",
		"@wordpress/compose": "^8.4.0",
		"@wordpress/data": "^10.40.0",
		"@wordpress/element": "^6.40.0",
		"@wordpress/i18n": "^6.13.0",
		"@wordpress/icons": "^11.7.0",
		"@wordpress/plugins": "^7.40.0",
		"dompurify": "^3.4.16",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/jest": "^30.0.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@types/wordpress__block-editor": "^15.0.6",
		"@wordpress/babel-preset-default": "^8.56.0",
		"@wordpress/e2e-test-utils-playwright": "^2.1.0",
		"@wordpress/env": "^11.16.0",
		"@wordpress/eslint-plugin": "^27.0.0",
		"@wordpress/prettier-config": "^4.56.0",
		"@wordpress/scripts": "^35.0.0",
		"@wordpress/stylelint-config": "^26.0.0",
		"cross-env": "^10.1.0",
		"eslint-plugin-jest": "^29.16.6",
		"jest-watch-typeahead": "^3.0.1",
		"lefthook": "^2.1.16",
		"lint-staged": "^17.6.0",
		"npm-run-all": "^4.1.5",
		"prettier": "npm:wp-prettier@^3",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"webpack-remove-empty-scripts": "^1.1.1"
	},
	"overrides": {
		"@types/node": "^24.0.0",
		"fast-xml-parser@<5.3.1": "^5.3.1",
		"markdownlint-cli": {
			"minimatch@<3.1.4": "^3.1.4"
		},
		"prettier": "npm:wp-prettier@^3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"serialize-javascript@<7.0.3": "^7.0.3",
		"uuid@<11.1.1": "^11.1.1",
		"webpack-dev-server@<5.2.1": "^5.2.1"
	},
	"allowScripts": {
		"lefthook@2.1.16": true
	}
}
