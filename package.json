{
	"name": "onedesign",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/rtCamp/OneDesign.git"
	},
	"engines": {
		"node": ">=22.21.1",
		"npm": ">=10.9.4"
	},
	"files": [
		"build/",
		"inc/",
		"vendor/",
		"languages/",
		"readme.txt",
		"onedesign.php",
		"uninstall.php"
	],
	"dependencies": {
		"@wordpress/api-fetch": "^7.40.0",
		"@wordpress/block-editor": "^15.11.0",
		"@wordpress/blocks": "^15.13.0",
		"@wordpress/components": "^30.9.0",
		"@wordpress/compose": "^8.4.0",
		"@wordpress/data": "^10.40.0",
		"@wordpress/element": "^6.40.0",
		"@wordpress/i18n": "^6.13.0",
		"@wordpress/icons": "^11.7.0",
		"@wordpress/plugins": "^7.40.0",
		"dompurify": "^3.3.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/jest": "^29.5.14",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@typescript-eslint/eslint-plugin": "^8.61.1",
		"@typescript-eslint/parser": "^8.61.1",
		"@wordpress/babel-preset-default": "^8.48.1",
		"@wordpress/browserslist-config": "^6.40.0",
		"@wordpress/env": "^10.39.0",
		"@wordpress/eslint-plugin": "^25.4.1",
		"@wordpress/prettier-config": "^4.48.0",
		"@wordpress/scripts": "^32.4.1",
		"@wordpress/stylelint-config": "^23.40.1",
		"browserslist": "^4.28.1",
		"cross-env": "^10.1.0",
		"css-minimizer-webpack-plugin": "^7.0.4",
		"eslint-plugin-jest": "^29.15.2",
		"jest-watch-typeahead": "^2.2.2",
		"npm-run-all": "^4.1.5",
		"prettier": "npm:wp-prettier@^3",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"webpack-remove-empty-scripts": "^1.1.1"
	},
	"scripts": {
		"build:dev": "cross-env NODE_ENV=development npm-run-all 'build:!(dev|prod)'",
		"build:js": "wp-scripts build --config ./webpack.config.js",
		"build:prod": "npm run clean && cross-env NODE_ENV=production npm-run-all 'build:!(dev|prod)' && composer install --no-dev --optimize-autoloader",
		"clean": "rimraf build",
		"format": "wp-scripts format",
		"i18n:make-pot": "wp-env run cli wp i18n make-pot . ./languages/onedesign.pot --exclude=node_modules,vendor,tests --ignore-domain=default",
		"i18n:make-json": "wp-env run cli wp i18n make-json languages/ --no-purge",
		"lint:css": "wp-scripts lint-style",
		"lint:css:fix": "npm run lint:css -- --fix",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:js": "wp-scripts lint-js",
		"lint:js:types": "tsc --noEmit",
		"lint:php:fix": "composer run-script format",
		"lint:php:stan": "composer run-script phpstan",
		"lint:php": "composer run-script lint",
		"lint": "npm-run-all --parallel lint:*",
		"plugin-zip": "wp-scripts plugin-zip",
		"start:js": "wp-scripts start --config ./webpack.config.js",
		"start": "npm-run-all --parallel start:*",
		"test:js": "wp-scripts test-unit-js",
		"test:js:coverage": "wp-scripts test-unit-js --coverage",
		"test:js:watch": "wp-scripts test-unit-js --watch",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/ composer run-script test",
		"wp-env": "wp-env"
	},
	"overrides": {
		"@babel/runtime": "^7.27.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"webpack-dev-server@<=5.2.0": ">=5.2.1",
		"minimatch": ">=10.2.1",
		"serialize-javascript": ">=7.0.3",
		"prettier": "npm:wp-prettier@^3",
		"eslint-plugin-import": {
			"minimatch": "^3.1.2"
		},
		"test-exclude": {
			"minimatch": "^3.0.4"
		},
		"@wp-playground/blueprints": {
			"ajv": ">=8.18.0"
		},
		"@wp-playground/tools": {
			"ajv": ">=8.18.0"
		},
		"@wp-playground/cli": {
			"ajv": ">=8.18.0"
		}
	}
}
