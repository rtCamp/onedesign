{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "OneDesign Demo",
		"description": "Synchronize block patterns across multiple WordPress sites. Create once, deploy anywhere with centralized pattern management for enterprise teams.",
		"author": "rtCamp",
		"categories": [
			"plugin",
			"multisite",
			"patterns",
			"enterprise"
		]
	},
	"landingPage": "/wp-admin/plugins.php",
	"preferredVersions": {
		"php": "8.4",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login",
			"username": "admin"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/rtCamp/OneDesign/releases/latest/download/onedesign.zip"
			},
			"options": {
				"activate": true
			}
		}
	]
}
